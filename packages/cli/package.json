{
  "name": "trigora",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trigora-dev/trigora"
  },
  "homepage": "https://trigora.dev/",
  "bugs": {
    "url": "https://github.com/trigora-dev/trigora/issues"
  },
  "keywords": [
    "durable-execution",
    "programs",
    "developer-tools",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "trigora": "./bin/shim.js"
  },
  "files": [
    "bin",
    "dist",
    "helper",
    "LICENSE",
    "LICENSE_NOTICES",
    "THIRD_PARTY_LICENSES",
    "licenses",
    "vendor/trigora",
    "vendor/trigora-local",
    "vendor/tcc-rust-compile"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-adapter.mjs && node scripts/vendor-local.mjs && node scripts/vendor-cli.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tcc-engine/frontend-typescript": "26.10.1",
    "@trigora/contracts": "1.0.0",
    "dotenv": "^17.4.1",
    "esbuild": "^0.27.7",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.1",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
