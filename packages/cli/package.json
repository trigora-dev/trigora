{
  "name": "trigora",
  "version": "0.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trigora-dev/trigora"
  },
  "homepage": "https://trigora.dev/",
  "bugs": {
    "url": "https://github.com/trigora-dev/trigora/issues"
  },
  "keywords": [
    "durable-execution",
    "programs",
    "developer-tools",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "trigora": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tcc-engine/bindings-javascript": "file:../../dist-packages/tcc-engine-bindings-javascript-0.1.0-rc.1.tgz",
    "@tcc-engine/frontend-typescript": "file:../../dist-packages/tcc-engine-frontend-typescript-0.1.0-rc.1.tgz",
    "@tcc-engine/host-node": "file:../../dist-packages/tcc-engine-host-node-0.1.0-rc.1.tgz",
    "@trigora/client": "workspace:^",
    "@trigora/contracts": "workspace:^",
    "@trigora/sdk": "workspace:^",
    "commander": "^14.0.3",
    "dotenv": "^17.4.1",
    "esbuild": "^0.27.7",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
